@{ViewData["Title"]="Discover events";var events=ViewBag.Events as JsonArray??new JsonArray();}
<section class="hero mb-4"><div class="eyebrow">Find your next finish line</div><h1 class="display-4 mt-2">YOUR RACE.<br/>YOUR PACE.</h1><p class="lead col-lg-7">Discover local running, walking and cycling events. Choose your challenge and make race day count.</p><a class="btn btn-race btn-lg" asp-controller="Account" asp-action="Register">Get started</a></section>
<div class="d-flex justify-content-between align-items-center flex-wrap mb-3"><div><div class="eyebrow text-danger">What's coming up</div><h2 class="section-title">Upcoming events</h2></div></div><form method="get" class="row g-2 mb-4"><div class="col-md-5"><input class="form-control" name="location" value="@ViewBag.Location" placeholder="Filter by location"/></div><div class="col-md-4"><input class="form-control" type="date" name="date" value="@(ViewBag.Date==null?"":((DateTime)ViewBag.Date).ToString("yyyy-MM-dd"))"/></div><div class="col-md-3"><button class="btn btn-dark w-100">Filter events</button></div></form>
<div class="row g-3">@foreach(var e in events){<div class="col-md-6 col-lg-4"><div class="card h-100"><img class="event-img card-img-top" src="@(e?["bannerImageURL"]?.ToString()??"https://images.unsplash.com/photo-1552674605-db6ffd4facb5?w=900")" alt="Event banner"/><div class="card-body"><span class="badge text-bg-dark">@(e?["eventType"])</span><h5 class="mt-2 fw-bold">@(e?["name"])</h5><p class="text-secondary mb-1">📍 @(e?["location"])</p><p class="text-secondary">📅 @(e?["eventDate"]) · @(e?["distanceKm"]) km</p><a class="btn btn-outline-dark" asp-controller="Account" asp-action="Login">View / enter event</a></div></div></div>}@if(events.Count==0){<div class="col-12"><div class="card empty">No events found. Try changing your filters or check back soon.</div></div>}</div>
