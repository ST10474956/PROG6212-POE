@{ViewData["Title"]="Organiser dashboard";var events=ViewBag.Events as JsonArray??new JsonArray();}<div class="d-flex justify-content-between align-items-center mb-4"><div><div class="eyebrow text-danger">Organiser workspace</div><h1 class="section-title">Dashboard</h1><p class="text-secondary">A quick overview of the events you manage.</p></div><a class="btn btn-race" asp-action="CreateEvent">+ Create event</a></div><div class="row g-3 mb-4"><div class="col-md-4"><div class="card p-4"><div class="text-secondary">Events listed</div><div class="stat">@ViewBag.Count</div></div></div><div class="col-md-4"><div class="card p-4"><div class="text-secondary">Upcoming events</div><div class="stat">@events.Count(e=>DateTime.TryParse(e?["eventDate"]?.ToString(),out var d)&&d>=DateTime.Today)</div></div></div><div class="col-md-4"><div class="card p-4"><div class="text-secondary">Quick action</div><a asp-action="Events" class="fw-bold">Manage all events →</a></div></div></div><h4 class="section-title mb-3">Your events</h4><div class="row g-3">@foreach(var e in events){<div class="col-lg-6"><div class="card p-3"><h5 class="fw-bold">@(e?["name"])</h5><p class="text-secondary mb-2">@(e?["eventDate"]) · @(e?["location"])</p><p class="small">Total enrolments: @(e?["categories"] is JsonArray ca?ca.Sum(c=>c?["enrolments"] is JsonArray en?en.Count:0):0)</p><div class="d-flex gap-2 flex-wrap"><a class="btn btn-sm btn-outline-dark" asp-action="Categories" asp-route-eventId="@(e?["eventID"])">Categories</a><a class="btn btn-sm btn-outline-dark" asp-action="Enrolments" asp-route-eventId="@(e?["eventID"])">Enrolments</a><a class="btn btn-sm btn-outline-dark" asp-action="Results" asp-route-eventId="@(e?["eventID"])">Results</a></div></div></div>}</div>
