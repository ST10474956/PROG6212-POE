@model EventVm
@{ViewData["Title"]=Model.EventID==0?"Create event":"Edit event";var editing=Model.EventID!=0;}<div class="row justify-content-center"><div class="col-lg-8"><div class="card p-4"><div class="eyebrow text-danger">Organiser workspace</div><h1 class="section-title">@(editing?"Edit event":"Create an event")</h1><form asp-action="@(editing?"EditEvent":"CreateEvent")" method="post" enctype="multipart/form-data"><input asp-for="EventID" type="hidden"/><input asp-for="BannerImageURL" type="hidden"/><div asp-validation-summary="ModelOnly" class="text-danger"></div><div class="mb-3"><label asp-for="Name" class="form-label"></label><input asp-for="Name" class="form-control"/><span asp-validation-for="Name" class="text-danger"></span></div><div class="mb-3"><label asp-for="Description" class="form-label"></label><textarea asp-for="Description" class="form-control" rows="3"></textarea></div><div class="row"><div class="col-md-6 mb-3"><label asp-for="EventDate" class="form-label"></label><input asp-for="EventDate" type="datetime-local" class="form-control"/><span asp-validation-for="EventDate" class="text-danger"></span></div><div class="col-md-6 mb-3"><label asp-for="Location" class="form-label"></label><input asp-for="Location" class="form-control"/></div><div class="col-md-6 mb-3"><label asp-for="DistanceKm" class="form-label">Distance (km)</label><input asp-for="DistanceKm" class="form-control"/><span asp-validation-for="DistanceKm" class="text-danger"></span></div><div class="col-md-6 mb-3"><label asp-for="EventType" class="form-label"></label><select asp-for="EventType" class="form-select"><option>Run</option><option>Walk</option><option>Cycle</option></select></div></div><div class="mb-3"><label asp-for="BannerFile" class="form-label">Event banner image</label><input asp-for="BannerFile" type="file" accept="image/*" class="form-control"/><small class="text-secondary">The image is sent to the API, which stores it in Azure Blob Storage.</small></div><button class="btn btn-race">Save event</button> <a asp-action="Events" class="btn btn-outline-secondary">Cancel</a></form></div></div></div>
