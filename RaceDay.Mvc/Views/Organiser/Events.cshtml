@{ViewData["Title"]="Manage events";var events=ViewBag.Events as JsonArray??new JsonArray();}<div class="d-flex justify-content-between mb-4"><div><div class="eyebrow text-danger">Organiser workspace</div><h1 class="section-title">Manage events</h1></div><a asp-action="CreateEvent" class="btn btn-race align-self-center">+ New event</a></div><div class="card p-3"><div class="table-responsive"><table class="table"><thead><tr><th>Event</th><th>Date</th><th>Location</th><th>Distance</th><th>Actions</th></tr></thead><tbody>@foreach(var e in events){<tr><td class="fw-bold">@(e?["name"])</td><td>@(e?["eventDate"])</td><td>@(e?["location"])</td><td>@(e?["distanceKm"]) km</td><td><div class="d-flex gap-1 flex-wrap"><a class="btn btn-sm btn-outline-secondary" asp-action="EditEvent" asp-route-id="@(e?["eventID"])">Edit</a><a class="btn btn-sm btn-outline-secondary" asp-action="Categories" asp-route-eventId="@(e?["eventID"])">Categories</a><a class="btn btn-sm btn-outline-secondary" asp-action="Enrolments" asp-route-eventId="@(e?["eventID"])">Entries</a><a class="btn btn-sm btn-outline-secondary" asp-action="Results" asp-route-eventId="@(e?["eventID"])">Results</a><form asp-action="DeleteEvent" method="post"><input type="hidden" name="id" value="@(e?["eventID"])"/><button class="btn btn-sm btn-outline-danger" onclick="return confirm('Delete this event?')">Delete</button></form></div></td></tr>}</tbody></table></div>@if(events.Count==0){<div class="empty">You have not created any events yet.</div>}</div>
