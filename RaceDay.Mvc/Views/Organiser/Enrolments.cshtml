@{ViewData["Title"]="Event enrolments";var rows=ViewBag.Enrolments as JsonArray??new JsonArray();}<h1 class="section-title">Participant enrolments</h1><p class="text-secondary">Event #@ViewBag.EventId</p><div class="card p-3"><div class="table-responsive"><table class="table"><thead><tr><th>Participant</th><th>Category</th><th>Date entered</th><th>Status</th></tr></thead><tbody>@foreach(var r in rows){<tr><td>@(r?["user"]?["fullName"])</td><td>@(r?["category"]?["name"])</td><td>@(r?["enrolmentDate"])</td><td><span class="badge badge-confirmed">@(r?["status"])</span></td></tr>}</tbody></table></div>@if(rows.Count==0){<div class="empty">No participants have entered this event yet.</div>}</div>