@{ViewData["Title"]="Event categories";var cats=ViewBag.Categories as JsonArray??new JsonArray();}<h1 class="section-title">Event categories</h1><p class="text-secondary">Event #@ViewBag.EventId</p><div class="row g-3"><div class="col-lg-5"><div class="card p-4"><h5>Add a category</h5><form asp-action="AddCategory" method="post"><input type="hidden" name="EventID" value="@ViewBag.EventId"/><div class="mb-3"><label class="form-label">Category name</label><input name="Name" required class="form-control" placeholder="10 km Open"/></div><div class="mb-3"><label class="form-label">Distance (km)</label><input name="DistanceKm" type="number" step="0.1" class="form-control"/></div><div class="mb-3"><label class="form-label">Maximum participants</label><input name="MaxParticipants" type="number" min="1" value="100" class="form-control"/></div><button class="btn btn-race">Add category</button></form></div></div><div class="col-lg-7"><div class="card p-3"><table class="table"><thead><tr><th>Category</th><th>Distance</th><th>Capacity</th></tr></thead><tbody>@foreach(var c in cats){<tr><td>@(c?["name"])</td><td>@(c?["distanceKm"]) km</td><td>@(c?["maxParticipants"])</td></tr>}</tbody></table>@if(cats.Count==0){<div class="empty">No categories have been added.</div>}</div></div></div>
