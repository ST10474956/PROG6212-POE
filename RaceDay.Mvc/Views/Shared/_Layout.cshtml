<!DOCTYPE html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>@ViewData["Title"] - RaceDay</title><link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"/><link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/></head><body><nav class="navbar navbar-expand-lg navbar-dark raced-nav"><div class="container"><a class="navbar-brand fw-bold" asp-controller="Home" asp-action="Index">🏁 RACE<span>DAY</span></a><button class="navbar-toggler" data-bs-toggle="collapse" data-bs-target="#nav"><span class="navbar-toggler-icon"></span></button><div class="collapse navbar-collapse" id="nav"><ul class="navbar-nav ms-auto align-items-lg-center gap-lg-2">
@if(Context.Session.GetString("Role")=="Organiser"){<li class="nav-item"><a class="nav-link" asp-controller="Organiser" asp-action="Index">Dashboard</a></li><li class="nav-item"><a class="nav-link" asp-controller="Organiser" asp-action="Events">Manage events</a></li>}
else if(Context.Session.GetString("Role")=="Participant"){<li class="nav-item"><a class="nav-link" asp-controller="Participant" asp-action="Index">Events</a></li><li class="nav-item"><a class="nav-link" asp-controller="Participant" asp-action="MyEvents">My entries</a></li><li class="nav-item"><a class="nav-link" asp-controller="Participant" asp-action="MyResults">My results</a></li><li class="nav-item"><a class="nav-link" asp-controller="Participant" asp-action="Profile">Profile</a></li>}
else{<li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index">Events</a></li><li class="nav-item"><a class="nav-link" asp-controller="Account" asp-action="Login">Login</a></li><li class="nav-item"><a class="btn btn-race btn-sm" asp-controller="Account" asp-action="Register">Join RaceDay</a></li>}
@if(!string.IsNullOrEmpty(Context.Session.GetString("Token"))){<li class="nav-item"><span class="nav-link small">Hi, @Context.Session.GetString("FullName")</span></li><li class="nav-item"><a class="nav-link" asp-controller="Account" asp-action="Logout">Logout</a></li>}
</ul></div></div></nav><main class="container py-4"><partial name="_Alerts"/>@RenderBody()</main><footer class="footer mt-5"><div class="container py-4 d-flex justify-content-between flex-wrap"><span>© @DateTime.Now.Year RaceDay — Run your race.</span><span>Built for every finish line.</span></div></footer><script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script></body></html>
