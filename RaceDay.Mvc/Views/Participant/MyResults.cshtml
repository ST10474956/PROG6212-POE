@{ViewData["Title"]="My results";var rows=ViewBag.Results as JsonArray??new JsonArray();}<div class="eyebrow text-danger">Participant area</div><h1 class="section-title">My race results</h1><p class="text-secondary">Your personal race history and finishing positions.</p><div class="card p-3"><div class="table-responsive"><table class="table"><thead><tr><th>Event</th><th>Date</th><th>Category</th><th>Finish time</th><th>Position</th></tr></thead><tbody>@foreach(var r in rows){<tr><td class="fw-bold">@(r?["eventName"])</td><td>@(r?["eventDate"])</td><td>@(r?["categoryName"])</td><td>@(r?["finishTime"])</td><td><span class="badge text-bg-dark">@(r?["position"]) of @(r?["totalFinishers"])</span></td></tr>}</tbody></table></div>@if(rows.Count==0){<div class="empty">Your results will appear here after an Organiser publishes them.</div>}</div>