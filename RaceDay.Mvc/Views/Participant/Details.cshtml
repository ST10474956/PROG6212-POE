@{ViewData["Title"]="Event details";var e=ViewBag.Event as JsonNode;var cats=ViewBag.Categories as JsonArray??new JsonArray();}<div class="card overflow-hidden mb-4"><img class="event-img w-100" style="height:300px" src="@(e?["bannerImageURL"]?.ToString()??"https://images.unsplash.com/photo-1552674605-db6ffd4facb5?w=1200")" alt="Event banner"/><div class="p-4"><div class="eyebrow text-danger">@(e?["eventType"])</div><h1 class="section-title">@(e?["name"])</h1><p>@(e?["description"])</p><p class="text-secondary">📅 @(e?["eventDate"]) · 📍 @(e?["location"]) · @(e?["distanceKm"]) km</p></div></div><h3 class="section-title">Choose your category</h3><div class="row g-3">@foreach(var c in cats){<div class="col-md-6"><div class="card p-3 d-flex flex-row justify-content-between align-items-center"><div><h5>@(c?["name"])</h5><small class="text-secondary">@(c?["distanceKm"]) km · capacity @(c?["maxParticipants"])</small></div><form asp-action="Enrol" method="post"><input type="hidden" name="categoryId" value="@(c?["categoryID"])"/><button class="btn btn-race">Enter event</button></form></div></div>}@if(cats.Count==0){<div class="empty">No categories have been published for this event.</div>}</div>
