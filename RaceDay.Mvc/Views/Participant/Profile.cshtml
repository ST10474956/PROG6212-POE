@{ViewData["Title"]="My profile";var p=ViewBag.Profile as JsonNode;}<div class="row justify-content-center"><div class="col-lg-7"><div class="card p-4"><div class="eyebrow text-danger">Participant area</div><h1 class="section-title">My profile</h1><div class="d-flex align-items-center gap-3 mb-4">@if(!string.IsNullOrEmpty(p?["profilePictureURL"]?.ToString())){<img src="@(p?["profilePictureURL"])" alt="Profile picture" width="90" height="90" style="object-fit:cover;border-radius:50%"/>}else{<div class="rounded-circle bg-light d-flex align-items-center justify-content-center" style="width:90px;height:90px;font-size:2rem">👤</div>}<div><h5>@(p?["fullName"])</h5><div class="text-secondary">@(p?["email"])</div><span class="badge text-bg-dark">@(p?["role"])</span></div></div><form asp-action="UpdateProfile" method="post" enctype="multipart/form-data"><div class="mb-3"><label class="form-label">Full name</label><input class="form-control" name="fullName" value="@(p?["fullName"])" required maxlength="100"/></div><div class="mb-3"><label class="form-label">Profile picture</label><input class="form-control" type="file" name="profilePicture" accept="image/*"/><small class="text-secondary">Uploaded through the API to Azure Blob Storage.</small></div><button class="btn btn-race">Save profile</button></form></div></div></div>
