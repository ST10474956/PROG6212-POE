@{ViewData["Title"]="My entries";var rows=ViewBag.Enrolments as JsonArray??new JsonArray();}<div class="eyebrow text-danger">Participant area</div><h1 class="section-title">My event entries</h1><div class="card p-3"><div class="table-responsive"><table class="table"><thead><tr><th>Event</th><th>Date</th><th>Category</th><th>Status</th></tr></thead><tbody>@foreach(var r in rows){var status=r?["status"]?.ToString()??"Pending";<tr><td class="fw-bold">@(r?["category"]?["event"]?["name"])</td><td>@(r?["category"]?["event"]?["eventDate"])</td><td>@(r?["category"]?["name"])</td><td><span class="badge @(status=="Confirmed"?"badge-confirmed":"badge-pending")">@status</span></td></tr>}</tbody></table></div>@if(rows.Count==0){<div class="empty">You have not entered any events yet. <a asp-action="Index">Browse events</a>.</div>}</div>